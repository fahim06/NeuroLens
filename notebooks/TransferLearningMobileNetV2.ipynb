   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# NeuroLens Transfer Learning with MobileNetV2\\n\",\n",
    "    \"\\n\",\n",
    "    \"## Overview\\n\",\n",
    "    \"This notebook implements **Transfer Learning** using MobileNetV2 for significantly improved accuracy on CIFAR-10 classification.\\n\",\n",
    "    \"\\n\",\n",
    "    \"### Why Transfer Learning?\\n\",\n",
    "    \"- **Pre-trained on ImageNet** (1.4M images, 1000 classes)\\n\",\n",
    "    \"- **Better feature extraction** than training from scratch\\n\",\n",
    "    \"- **Faster training** with fewer epochs needed\\n\",\n",
    "    \"- **Higher accuracy** on real-world images\\n\",\n",
    "    \"\\n\",\n",
    "    \"### Expected Results\\n\",\n",
    "    \"- **CIFAR-10 Test Accuracy:** 85-92%\\n\",\n",
    "    \"- **Real-world Image Performance:** 70-85%\\n\",\n",
    "    \"\\n\",\n",
    "    \"---\\n\",\n",
    "    \"\\n\",\n",
    "    \"> **Version:** 2.1.0  \\n\",\n",
    "    \"> **Date:** January 26, 2026  \\n\",\n",
    "    \"> **Author:** NeuroLens Team\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 1. Setup & Imports\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import tensorflow as tf\\n\",\n",
    "    \"from tensorflow.keras import datasets, layers, models, callbacks\\n\",\n",
    "    \"from tensorflow.keras.applications import MobileNetV2\\n\",\n",
    "    \"from tensorflow.keras.preprocessing.image import ImageDataGenerator\\n\",\n",
    "    \"from tensorflow.keras.utils import to_categorical\\n\",\n",
    "    \"import warnings\\n\",\n",
    "    \"warnings.filterwarnings('ignore')\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'TensorFlow version: {tf.__version__}')\\n\",\n",
    "    \"print(f'GPU Available: {len(tf.config.list_physical_devices(\\\"GPU\\\")) > 0}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# For M1/M2 Macs - use legacy optimizer for better performance\\n\",\n",
    "    \"import platform\\n\",\n",
    "    \"if platform.processor() == 'arm':\\n\",\n",
    "    \"    print('Apple Silicon detected - will use legacy optimizer')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 2. Load and Prepare CIFAR-10 Data\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load CIFAR-10 dataset\\n\",\n",
    "    \"(x_train, y_train), (x_test, y_test) = datasets.cifar10.load_data()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Class names mapping (same as classifier.py)\\n\",\n",
    "    \"class_names = {\\n\",\n",
    "    \"    0: 'airplane', 1: 'automobile', 2: 'bird', 3: 'cat', 4: 'deer',\\n\",\n",
    "    \"    5: 'dog', 6: 'frog', 7: 'horse', 8: 'ship', 9: 'truck'\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Training samples: {len(x_train)}')\\n\",\n",
    "    \"print(f'Test samples: {len(x_test)}')\\n\",\n",
    "    \"print(f'Original image shape: {x_train[0].shape}')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 3. Upscale Images for MobileNetV2\\n\",\n",
    "    \"\\n\",\n",
    "    \"MobileNetV2 expects at least 32x32 input, but works better with larger images.\\n\",\n",
    "    \"We'll upscale to 96x96 for better feature extraction while keeping memory manageable.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Target size for MobileNetV2 (96x96 is a good balance)\\n\",\n",
    "    \"IMG_SIZE = 96\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Upscale images using bilinear interpolation\\n\",\n",
    "    \"def upscale_images(images, target_size):\\n\",\n",
    "    \"    \\\"\\\"\\\"Upscale images to target size using TensorFlow.\\\"\\\"\\\"\\n\",\n",
    "    \"    return tf.image.resize(images, [target_size, target_size], method='bilinear').numpy()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Upscaling training images to {IMG_SIZE}x{IMG_SIZE}...')\\n\",\n",
    "    \"x_train_upscaled = upscale_images(x_train, IMG_SIZE)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Upscaling test images to {IMG_SIZE}x{IMG_SIZE}...')\\n\",\n",
    "    \"x_test_upscaled = upscale_images(x_test, IMG_SIZE)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Upscaled image shape: {x_train_upscaled[0].shape}')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Normalize to 0-1 range\\n\",\n",
    "    \"x_train_norm = x_train_upscaled.astype('float32') / 255.0\\n\",\n",
    "    \"x_test_norm = x_test_upscaled.astype('float32') / 255.0\\n\",\n",
    "    \"\\n\",\n",
    "    \"# One-hot encode labels\\n\",\n",
    "    \"y_train_cat = to_categorical(y_train, 10)\\n\",\n",
    "    \"y_test_cat = to_categorical(y_test, 10)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Normalized range: [{x_train_norm.min():.2f}, {x_train_norm.max():.2f}]')\\n\",\n",
    "    \"print(f'Label shape: {y_train_cat[0].shape}')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. Visualize Upscaled Samples\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Show comparison: original vs upscaled\\n\",\n",
    "    \"fig, axes = plt.subplots(2, 5, figsize=(15, 6))\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i in range(5):\\n\",\n",
    "    \"    # Original 32x32\\n\",\n",
    "    \"    axes[0, i].imshow(x_train[i])\\n\",\n",
    "    \"    axes[0, i].set_title(f'Original 32x32\\\\n{class_names[y_train[i][0]]}')\\n\",\n",
    "    \"    axes[0, i].axis('off')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Upscaled 96x96\\n\",\n",
    "    \"    axes[1, i].imshow(x_train_norm[i])\\n\",\n",
    "    \"    axes[1, i].set_title(f'Upscaled {IMG_SIZE}x{IMG_SIZE}')\\n\",\n",
    "    \"    axes[1, i].axis('off')\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.suptitle('Original vs Upscaled Images', fontsize=14)\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 5. Data Augmentation\\n\",\n",
    "    \"\\n\",\n",
    "    \"Strong augmentation for better generalization to real-world images.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Enhanced data augmentation\\n\",\n",
    "    \"datagen = ImageDataGenerator(\\n\",\n",
    "    \"    rotation_range=20,           # Random rotation up to 20 degrees\\n\",\n",
    "    \"    width_shift_range=0.15,      # Horizontal shift up to 15%\\n\",\n",
    "    \"    height_shift_range=0.15,     # Vertical shift up to 15%\\n\",\n",
    "    \"    horizontal_flip=True,        # Random horizontal flip\\n\",\n",
    "    \"    zoom_range=0.15,             # Random zoom up to 15%\\n\",\n",
    "    \"    shear_range=0.1,             # Shear transformation\\n\",\n",
    "    \"    brightness_range=[0.8, 1.2], # Brightness variation\\n\",\n",
    "    \"    fill_mode='nearest'          # Fill strategy for new pixels\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"datagen.fit(x_train_norm)\\n\",\n",
    "    \"print('Enhanced data augmentation configured')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 6. Build MobileNetV2 Transfer Learning Model\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def build_mobilenet_model(input_shape=(96, 96, 3), num_classes=10, trainable_layers=50):\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    Build a transfer learning model using MobileNetV2.\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Args:\\n\",\n",
    "    \"        input_shape: Input image shape\\n\",\n",
    "    \"        num_classes: Number of output classes\\n\",\n",
    "    \"        trainable_layers: Number of top layers to make trainable\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    Returns:\\n\",\n",
    "    \"        Compiled Keras model\\n\",\n",
    "    \"    \\\"\\\"\\\"\\n\",\n",
    "    \"    # Load MobileNetV2 with ImageNet weights (exclude top layers)\\n\",\n",
    "    \"    base_model = MobileNetV2(\\n\",\n",
    "    \"        input_shape=input_shape,\\n\",\n",
    "    \"        include_top=False,\\n\",\n",
    "    \"        weights='imagenet',\\n\",\n",
    "    \"        pooling='avg'\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Freeze early layers, train top layers\\n\",\n",
    "    \"    for layer in base_model.layers[:-trainable_layers]:\\n\",\n",
    "    \"        layer.trainable = False\\n\",\n",
    "    \"    for layer in base_model.layers[-trainable_layers:]:\\n\",\n",
    "    \"        layer.trainable = True\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Build the complete model\\n\",\n",
    "    \"    model = models.Sequential([\\n\",\n",
    "    \"        base_model,\\n\",\n",
    "    \"        layers.Dense(256, activation='relu'),\\n\",\n",
    "    \"        layers.BatchNormalization(),\\n\",\n",
    "    \"        layers.Dropout(0.5),\\n\",\n",
    "    \"        layers.Dense(128, activation='relu'),\\n\",\n",
    "    \"        layers.BatchNormalization(),\\n\",\n",
    "    \"        layers.Dropout(0.3),\\n\",\n",
    "    \"        layers.Dense(num_classes, activation='softmax')\\n\",\n",
    "    \"    ])\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return model\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Build the model\\n\",\n",
    "    \"model = build_mobilenet_model(input_shape=(IMG_SIZE, IMG_SIZE, 3))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Print model summary\\n\",\n",
    "    \"print(f'\\\\nTotal layers: {len(model.layers)}')\\n\",\n",
    "    \"print(f'Trainable parameters: {model.count_params():,}')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Model summary\\n\",\n",
    "    \"model.summary()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 7. Compile Model\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Use legacy optimizer for M1/M2 Macs\\n\",\n",
    "    \"import platform\\n\",\n",
    "    \"\\n\",\n",
    "    \"LEARNING_RATE = 0.0001  # Lower LR for transfer learning\\n\",\n",
    "    \"\\n\",\n",
    "    \"if platform.processor() == 'arm':\\n\",\n",
    "    \"    # Use legacy optimizer for Apple Silicon\\n\",\n",
    "    \"    optimizer = tf.keras.optimizers.legacy.Adam(learning_rate=LEARNING_RATE)\\n\",\n",
    "    \"    print('Using legacy Adam optimizer for Apple Silicon')\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    optimizer = tf.keras.optimizers.Adam(learning_rate=LEARNING_RATE)\\n\",\n",
    "    \"    print('Using standard Adam optimizer')\\n\",\n",
    "    \"\\n\",\n",
    "    \"model.compile(\\n\",\n",
    "    \"    optimizer=optimizer,\\n\",\n",
    "    \"    loss='categorical_crossentropy',\\n\",\n",
    "    \"    metrics=['accuracy']\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'Learning rate: {LEARNING_RATE}')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 8. Training Callbacks\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Define callbacks\\n\",\n",
    "    \"training_callbacks = [\\n\",\n",
    "    \"    # Early stopping\\n\",\n",
    "    \"    callbacks.EarlyStopping(\\n\",\n",
    "    \"        monitor='val_accuracy',\\n\",\n",
    "    \"        patience=15,\\n\",\n",
    "    \"        restore_best_weights=True,\\n\",\n",
    "    \"        verbose=1,\\n\",\n",
    "    \"        min_delta=0.001\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"    # Reduce learning rate on plateau\\n\",\n",
    "    \"    callbacks.ReduceLROnPlateau(\\n\",\n",
    "    \"        monitor='val_loss',\\n\",\n",
    "    \"        factor=0.5,\\n\",\n",
    "    \"        patience=5,\\n\",\n",
    "    \"        min_lr=1e-7,\\n\",\n",
    "    \"        verbose=1\\n\",\n",
    "    \"    ),\\n\",\n",
    "    \"    # Save best model\\n\",\n",
    "    \"    callbacks.ModelCheckpoint(\\n\",\n",
    "    \"        '../assets/mobilenet_cifar10.keras',\\n\",\n",
    "    \"        monitor='val_accuracy',\\n\",\n",
    "    \"        save_best_only=True,\\n\",\n",
    "    \"        verbose=1\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('Callbacks configured')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 9. Train the Model\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"%%time\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Training parameters\\n\",\n",
    "    \"EPOCHS = 50\\n\",\n",
    "    \"BATCH_SIZE = 32\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Train with data augmentation\\n\",\n",
    "    \"history = model.fit(\\n\",\n",
    "    \"    datagen.flow(x_train_norm, y_train_cat, batch_size=BATCH_SIZE),\\n\",\n",
    "    \"    epochs=EPOCHS,\\n\",\n",
    "    \"    validation_data=(x_test_norm, y_test_cat),\\n\",\n",
    "    \"    callbacks=training_callbacks,\\n\",\n",
    "    \"    verbose=1\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'\\\\n✅ Training completed!')\\n\",\n",
    "    \"print(f'Best validation accuracy: {max(history.history[\\\"val_accuracy\\\"]):.4f}')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 10. Visualize Training History\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"fig, axes = plt.subplots(1, 2, figsize=(14, 5))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Accuracy plot\\n\",\n",
    "    \"axes[0].plot(history.history['accuracy'], label='Training Accuracy', linewidth=2)\\n\",\n",
    "    \"axes[0].plot(history.history['val_accuracy'], label='Validation Accuracy', linewidth=2)\\n\",\n",
    "    \"axes[0].set_title('Model Accuracy', fontsize=14)\\n\",\n",
    "    \"axes[0].set_xlabel('Epoch')\\n\",\n",
    "    \"axes[0].set_ylabel('Accuracy')\\n\",\n",
    "    \"axes[0].legend()\\n\",\n",
    "    \"axes[0].grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Loss plot\\n\",\n",
    "    \"axes[1].plot(history.history['loss'], label='Training Loss', linewidth=2)\\n\",\n",
    "    \"axes[1].plot(history.history['val_loss'], label='Validation Loss', linewidth=2)\\n\",\n",
    "    \"axes[1].set_title('Model Loss', fontsize=14)\\n\",\n",
    "    \"axes[1].set_xlabel('Epoch')\\n\",\n",
    "    \"axes[1].set_ylabel('Loss')\\n\",\n",
    "    \"axes[1].legend()\\n\",\n",
    "    \"axes[1].grid(True, alpha=0.3)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.tight_layout()\\n\",\n",
    "    \"plt.savefig('../assets/training_history_mobilenet.png', dpi=150)\\n\",\n",
    "    \"plt.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('Training history saved to assets/training_history_mobilenet.png')\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 11. Evaluate on Test Set\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Load best model\\n\",\n",
    "    \"best_model = models.load_model('../assets/mobilenet_cifar10.keras')\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Evaluate\\n\",\n",
    "    \"test_loss, test_accuracy = best_model.evaluate(x_test_norm, y_test_cat, verbose=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print('=' * 50)\\n\",\n",
    "    \"print('📊 FINAL EVALUATION RESULTS')\\n\",\n",
    "    \"print('=' * 50)\\n\",\n",
    "    \"print(f'Test Loss:     {test_loss:.4f}')\\n\",\n",
    "    \"print(f'Test Accuracy: {test_accuracy:.4f} ({test_accuracy*100:.2f}%)')\\n\",\n",
    "    \"print('=' * 50)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 12. Confusion Matrix\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from sklearn.metrics import confusion_matrix, classification_report\\n\",\n",
    "    \"import seaborn as sns\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Get predictions\\n\",\n",
    "    \"y_pred = best_model.predict(x_test_norm, verbose=0)\\n\",\n",
    "    \"y_pred_classes = np.argmax(y_pred, axis=1)\\n\",\n",
    "    \"y_true_classes = y_test.flatten()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Confusion matrix\\n\",\n",
    "    \"cm = confusion_matrix(y_true_classes, y_pred_classes)\\n\",\n",
    "    \"\\n\",\n",
    "    \"plt.figure(figsize=(10, 8))\\n\",\n",
