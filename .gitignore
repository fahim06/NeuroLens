!assets/baseline_mariya.keras

# Datasets (large files)
ml/datasets/raw/
ml/datasets/processed/
data/
datasets/
*.csv
*.tsv
*.parquet
*.feather
!**/test_*.csv

# Experiment tracking
wandb/
mlruns/
.mlflow/
tensorboard_logs/
runs/
lightning_logs/

# Model registry local storage
ml/registry/models/
registry.json

