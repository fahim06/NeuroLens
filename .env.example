# ============================================================
# NeuroLens — Environment Variables Template
# ============================================================
# Copy to .env and configure for your environment
# ============================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Django Settings
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database (PostgreSQL)
POSTGRES_DB=neurolens
POSTGRES_USER=neurolens
POSTGRES_PASSWORD=neurolens_secret
POSTGRES_PORT=5432
DATABASE_URL=postgres://neurolens:neurolens_secret@postgres:5432/neurolens

# Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Service Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend
VITE_API_URL=/api
